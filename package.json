{
  "name": "munch-food-concierge",
  "version": "0.1.0",
  "description": "Food Concierge: a model-agnostic MCP server that compares food delivery apps by true all-in cost.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "munch-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "data",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --target node20 --clean --sourcemap",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "harness:smoke": "tsx harness/smoke.ts",
    "harness:claude": "tsx harness/chat.ts --llm claude",
    "harness:openai": "tsx harness/chat.ts --llm openai",
    "record": "tsx scripts/record.ts",
    "try": "tsx scripts/try.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@napi-rs/keyring": "^2.1.2",
    "playwright": "^1.63.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@openai/agents": "^0.21.0",
    "@types/node": "^26.6.6",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
